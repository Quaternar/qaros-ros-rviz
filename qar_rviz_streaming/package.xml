<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>qar_rviz_streaming</name>
  <version>0.1.0</version>
  <description>
    RViz2 panel plugin for the Qar Streaming integration. It packages the reusable
    qar_ogre_streaming and qar_qt_streaming libraries and exposes Qar stereo
    streaming, AR GUI panels and spatial AR interaction inside RViz2 as an
    rviz_common::Panel.
  </description>
  <maintainer email="contact@quaternar.com">Quaternar</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rviz_common</depend>
  <depend>rviz_rendering</depend>
  <depend>rviz_ogre_vendor</depend>
  <depend>rviz_default_plugins</depend>
  <depend>pluginlib</depend>
  <depend>ament_index_cpp</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>qtbase5-dev</depend>

  <exec_depend>libqt5-widgets</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <rviz_common plugin="${prefix}/plugin_description.xml"/>
  </export>
</package>
